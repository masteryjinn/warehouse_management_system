# JWT Settings
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database Settings
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=WarehouseDB
DB_HOST=db
DB_NAME=WarehouseDB

# Database Users Passwords
DB_AUTH_PASSWORD=your_db_auth_password
DB_CHANGE_PASSWORD=your_db_change_password
DB_ADMIN_PASSWORD=your_db_admin_password

# System & Backup Settings
MYSQL_PATH=mysql
TEMP_PASSWORD_LENGTH=10
BACKUP_SECRET_KEY=your_backup_encryption_secret_key

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# Backup Settings
BACKUP_DIR=backups
MAX_BACKUPS=7
BACKUP_RETENTION_DAYS=30